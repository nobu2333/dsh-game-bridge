# 依赖与产物
node_modules/
*.tgz

# 本地调试
tmp/
*.log
npm-debug.log*

# 引擎缓存（首次激活时下载，不进仓库）
# 注意：engine/ 是引擎源码目录，要入库；只挡它下面的构建产物。
.cache/
.engine-cache/
engine/.venv/
engine/build/
engine/dist/
engine/*.egg-info/
engine/**/__pycache__/

# 隔离的 DSH_HOME：本地验证官方安装链路用，绝不入库
.dsh-test/

# 集成测试产物
test/integration/.out/

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python 构建产物（uv/pip 安装本地包时会产生）
**/build/
*.egg-info/
**/__pycache__/
